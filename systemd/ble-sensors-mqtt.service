[Unit]
Description=BLE sensor gateway to MQTT, Prometheus and SNMP
Documentation=https://github.com/desalvo/ble-sensors-mqtt
After=bluetooth.target network-online.target
Wants=bluetooth.target network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ble-sensors-mqtt
Group=ble-sensors-mqtt
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
StateDirectory=ble-sensors-mqtt
StateDirectoryMode=0750
ExecStart=/opt/ble-sensors-mqtt/.venv/bin/ble-sensors-mqtt --config /etc/ble-sensors-mqtt/config.toml
Restart=on-failure
RestartSec=10s
TimeoutStartSec=45s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
