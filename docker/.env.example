# MQTT is an outbound connection from the container to this broker.
MQTT_HOST=mqtt.example.net
MQTT_PORT=8883
MQTT_USERNAME=ble-sensors-publisher
MQTT_TLS=true
# Set true only when intentionally using plaintext MQTT to a remote broker.
ALLOW_INSECURE_MQTT=false
MQTT_TOPIC_PREFIX=ble-sensors
MQTT_CACHE_ENABLED=true
MQTT_CACHE_PATH=/var/lib/ble-sensors-mqtt/mqtt-cache.sqlite3
MQTT_CACHE_MAX_SIZE=1GiB
REUSE_STALE_DATA=false

POLL_INTERVAL=30
SCAN_DURATION=8
# Linux/BlueZ only; leave blank to use the OS default adapter.
BLUETOOTH_ADAPTER=

HOME_ASSISTANT_DISCOVERY=true
HOME_ASSISTANT_DISCOVERY_PREFIX=homeassistant

# The application must bind to 0.0.0.0 inside the container so Docker can publish it.
PROMETHEUS_ENABLED=true
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=9105
ALLOW_EXTERNAL_PROMETHEUS=true

SNMP_ENABLED=false
SNMP_HOST=0.0.0.0
SNMP_PORT=1161
ALLOW_EXTERNAL_SNMP=true

# Optional authenticated web frontend. Use TLS at the app or a TLS reverse proxy.
FRONTEND_ENABLED=false
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8080
FRONTEND_DATA_DIR=/var/lib/ble-sensors-mqtt/frontend
ALLOW_EXTERNAL_FRONTEND=true
# FRONTEND_TLS_CERT=/run/secrets/frontend-cert.pem
# FRONTEND_TLS_KEY=/run/secrets/frontend-key.pem
